# REQUIRED BACKEND SECRETS
# Backend reverse-search provider. SEARCH_API_KEY is a compatibility alias.
# The backend auto-loads this file from the repository root via python-dotenv.
SERPAPI_KEY=

# Sepolia chain client and Hardhat deployment.
RPC_URL=
# Exactly 32 bytes (64 hexadecimal characters, with an optional 0x prefix).
# Use a dedicated testnet-only account; do not paste the public wallet address.
PRIVATE_KEY=

# IPFS pinning. IPFS_API_KEY is a compatibility alias.
PINATA_JWT=

# REQUIRED BACKEND PUBLIC CONFIGURATION
# This is public contract metadata, not a secret. Set the deployed address
# from contracts/deployed_address.txt (or another compatible Sepolia address).
CONTRACT_ADDRESS=
# Exact comma-separated browser origins; HTTPS is required outside localhost.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# OPTIONAL BACKEND READ CONFIGURATION
# Read-only verification path-gateway bases. Do not include a CID.
IPFS_GATEWAY_URL=https://ipfs.io/ipfs
IPFS_FALLBACK_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# OPTIONAL COST PROTECTION (defaults are conservative for one worker)
RATE_LIMIT_WINDOW_SECONDS=600
ANALYZE_RATE_LIMIT=5
ANALYZE_GLOBAL_RATE_LIMIT=60
CONFIRM_RATE_LIMIT=10
CONFIRM_GLOBAL_RATE_LIMIT=120
VERIFY_RATE_LIMIT=60
VERIFY_GLOBAL_RATE_LIMIT=600
